[Unit]
Description=HostSeal fleet management agent
Documentation=https://github.com/pascalgross/hostseal
Documentation=file:///usr/share/doc/hostseal-agent/README.md
After=network-online.target
Wants=network-online.target

# The helper sockets are enabled independently and come up at boot with sockets.target; these lines are
# what makes `systemctl start hostseal-agent` on a host where somebody stopped them bring them back.
# Without the ordering, the agent's first privileged job of the boot would fail on a socket that was
# about to exist.
Wants=hostseal-apply-updates.socket hostseal-restart-unit.socket hostseal-reboot-host.socket
After=hostseal-apply-updates.socket hostseal-restart-unit.socket hostseal-reboot-host.socket

[Service]
Type=exec
ExecStart=/usr/bin/hostseal-agent run
Restart=always
RestartSec=5s

# The agent connects outbound only and holds no listening socket, so there is no reason for it to run
# with any privilege at all. Everything below is what "zero capabilities" means in practice; the three
# root helpers in /usr/libexec/hostseal are the only privileged operations that exist, and each of them
# re-reads and re-enforces /etc/hostseal/policy.toml itself.
User=hostseal
Group=hostseal

# The agent reaches the three root helpers over the unix sockets in /run/hostseal, never through sudo.
# That is not a preference: with the no-new-privileges bit set, execve drops the setuid bit, so sudo
# cannot become root at all — and systemd *implies* NoNewPrivileges=yes from ProtectKernelTunables,
# ProtectKernelModules, ProtectClock, RestrictNamespaces, RestrictSUIDSGID, MemoryDenyWriteExecute,
# LockPersonality and SystemCallFilter, every one of which this unit sets. Every hardening line below
# therefore stays, and the privilege boundary is a socket the kernel authenticates rather than a setuid
# binary this sandbox would have to be dismantled to permit. See docs/SECURITY.md section 6.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# ProtectHome= and PrivateTmp= give this unit a mount namespace in which /home, /root and /tmp are empty
# filesystems, whatever the host has underneath. That is worth having and it does make the resources
# collector blind to a separate /home partition — so the collector names those three paths in its report
# rather than reporting a host that has no such disk, which is the same "plausible number rather than an
# error" failure the block below is about. Widening the sandbox to see them would trade a stated gap for
# an unstated risk; the gap is the better half of that trade, and it is stated.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
# Read-only rather than invisible, and it must stay that way: the containers collector reads the
# unified cgroup hierarchy, and systemd 256's ProtectControlGroups=private would give this unit its own
# cgroup namespace, which makes the collector report zero containers with no error at all. The same
# applies to ProtectProc=, which is deliberately not set here: ProtectProc=invisible would hide every
# process the agent does not own and produce the same silent zero. Both are the "plausible number
# rather than an error" failure this project tries hardest not to ship.
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Incompatible with any JIT runtime, which is one of the reasons the agent is written in Go. Choosing a
# JIT language would have silently cost this line.
MemoryDenyWriteExecute=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# AF_UNIX is required to reach the systemd D-Bus interface, which is how unit state is read — systemctl
# has no machine-readable output mode. AF_NETLINK is required by net.Interfaces() on Linux: without it,
# network fact collection returns nothing and does so quietly, which is exactly the class of failure
# this project tries not to ship. Per-interface traffic counters are deliberately read from /proc/net/dev
# instead, so the one section that would otherwise need netlink twice needs it once.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

ReadWritePaths=/var/lib/hostseal /var/log/hostseal
UMask=0077

[Install]
WantedBy=multi-user.target
